# minimal_test.enaml
from enaml.widgets.api import Window, Container, ScrollArea, VGroup
from ui.WrappingLabel import WrappingLabel
from enaml.widgets.api import VGroup, Label, Container
from ui.WrappingLabel import WrappingLabel
from enaml.styling import Setter, StyleSheet, Style
from enaml.core.api import Conditional
from enaml.layout.api import spacer


enamldef TestWindow(Window):
    title = 'WrappingLabel Alignment Test'
    initial_size = (500, 400)
    StyleSheet:
        Style:
            style_class = 'hh'
            Setter:
                field = 'color'
                value = '#eba626'
            Setter:
                field = 'background-color'
                value = 'red'
        Style:
            style_class = 'body'
            Setter:
                field = 'background-color'
                value = '#2255a1'
        Style:
            style_class = 'test'
            Setter:
                field = 'background-color'
                value = 'green'
    Container:
        ScrollArea:
            vertical_policy = 'as_needed'
            horizontal_policy = 'always_off'
            
            VGroup:
              
                WrappingLabel:
                    text = "I think close to getting the signing date and location."
                    word_wrap = False
                    style_class = 'hh'
                
                WrappingLabel:
                    text = "2. " + ("Medium text that wraps " * 5)
                    word_wrap = True

                WrappingLabel:
                    text = "I think close to getting the signing date and location."
                    word_wrap = True
                    style_class = 'hh'
                
                WrappingLabel:
                    text = "3. " + ("Very asdf sd fasfd asddf sdaf long text that demonstrates wrapping behavior " * 10)
                    style_class = 'body'
                
                WrappingLabel:
                    text = "The deal is a first and important step toward ensuring Iranians do not get a nuclear weapon."
                    word_wrap = True
                
                WrappingLabel:
                    text = "5. Test with numbers: 1234567890" * 3
                    word_wrap = True
                    style_class = 'test'