from enaml.widgets.api import Window, Container, ScrollArea, MultilineField, PushButton, Label
from enaml.layout.api import vbox, hbox
from enaml.core.api import Looper
from atom.api import List, Str
from enaml.styling import StyleSheet, Setter, Style

enamldef NewsWindow(Window):
    # Reactive data model
    attr news_items = []
    
    title = 'Financial News Monitor'
    initial_size = (700, 600)
    
    # Style sheet for custom colors
    StyleSheet:
        Style:
            element = 'Label'
            Setter:
                field = 'color'
                value = '#109d20'
    
    Container:        
        # Header
        Label:
            text = '📈 Live Financial News Monitor'
        
        # Control panel
        Container:
            PushButton:
                text = '▶ Start Monitoring'
                clicked :: start_monitoring
            PushButton:
                text = '⏹ Stop Monitoring'
                clicked :: stop_monitoring
            PushButton:
                text = '🗑 Clear All'
                clicked :: clear_news
        
        # Scrollable news area
        ScrollArea:
            vertical_policy = 'as_needed'
            horizontal_policy = 'as_needed'
            
            Container:
                
                # Dynamically create news items using Looper
                Looper:
                    iterable := news_items
                    
                    Container:
                        
                        # News header with timestamp
                        Label:
                            text << f"[{loop_item.time}] {loop_item.source}"
                        
                        # News content
                        Label:
                            text << loop_item.content
                        
                        # Divider
                        Label:
                            text = '─────────────────────'
        
        # Status bar
        Label:
            text = '⚪ Ready'
