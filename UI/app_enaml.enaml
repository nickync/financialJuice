from enaml.widgets.api import Window, Container, ScrollArea, VGroup, PushButton, Label
from enaml.layout.api import vbox, hbox
from enaml.core.api import Looper
from atom.api import List, Str
from enaml.styling import StyleSheet, Setter, Style
from ui.WrappingLabel import WrappingLabel

enamldef NewsWindow(Window):
    # Reactive data model
    attr news_items = []
    
    title = 'Financial News Monitor'
    initial_size = (700, 600)
    
    # Style sheet for custom colors
    StyleSheet:
        Style:
            style_class = 'headline'
            Setter:
                field = 'color'
                value = '#969ca0'
        Style:
            style_class = 'body'
            Setter:
                field = 'color'
                value = '#2255a1'
    
    VGroup:        
        # Header
        Label:
            text = '📈 Live Financial News Monitor'
        
        WrappingLabel:
            text = "TEST: This should be left aligned"
            word_wrap = True
            #style_class = 'headline'  # Keep style to test if it affects

        # Scrollable news area
        ScrollArea:
            vertical_policy = 'as_needed'
            horizontal_policy = 'always_off'
            
            VGroup:
                
                # Dynamically create news items using Looper
                Looper:
                    iterable := news_items
                    
                    VGroup:
                        
                        # News header with timestamp
                        WrappingLabel:
                            text << loop_item.to_text()
                            style_class = 'headline'
                        


        
        # Status bar
        Label:
            text = '⚪ Ready'
